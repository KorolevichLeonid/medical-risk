# Database Configuration
# SQLite для разработки
DATABASE_URL=sqlite:///../medical_risk.db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=true
APP_NAME=Medical Risk Analysis API

# CORS (for development and production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://medical-risk-frontend.onrender.com,https://medical-risk-backend.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://medical-risk-frontend.onrender.com,https://medical-risk-backend.onrender.com
